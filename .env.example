# ---------------------------------------------------------------------------
# Payments (required): Razorpay
# Dashboard → Account & Settings → API Keys. Use rzp_test_... keys to test,
# then swap to rzp_live_... keys once your account is activated.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Account & Settings → Webhooks → Add: https://<your-domain>/api/payment/webhook
# Event: payment.captured. Paste the secret you choose there:
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Confirmation emails (set ONE option)
# ---------------------------------------------------------------------------
# Option A: Gmail (easiest). Needs 2-Step Verification on, then create an
# App Password at https://myaccount.google.com/apppasswords (16 characters).
GMAIL_USER=agampreetsingh646@gmail.com
GMAIL_APP_PASSWORD=

# Option B: Resend, with a sender on a domain you verified in Resend.
# (onboarding@resend.dev can only email YOU, not your students.)
RESEND_API_KEY=
MAIL_FROM=RedRoot <payments@yourdomain.com>

# Name shown as the sender, and where your own "new payment" emails go.
MAIL_FROM_NAME=RedRoot
NOTIFY_EMAIL=agampreetsingh646@gmail.com
# Optional: where students' replies go (defaults to the email in lib/site.ts).
REPLY_TO_EMAIL=agampreetsingh646@gmail.com

# Your production URL, used for SEO metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=https://redroot.vercel.app
